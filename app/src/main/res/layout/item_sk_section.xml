<?xml version="1.0" encoding="utf-8"?>
<!-- kxkb-style section header: a full-width 1px hairline spacer above the group (hidden for the
     first section), then a big bold heading with a TEXT-WIDE underline — the underline is a
     match_parent View inside a wrap_content wrapper, so it spans exactly the heading text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <View
        android:id="@+id/sk_section_spacer"
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/sk_section_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/sk_section_rule"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
