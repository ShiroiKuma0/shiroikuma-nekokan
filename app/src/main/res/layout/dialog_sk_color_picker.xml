<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/sk_recent_colors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/sk_picker_old_color"
                android:layout_width="44dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/sk_picker_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="→"
                android:textSize="16sp" />

            <View
                android:id="@+id/sk_picker_new_color"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sk_picker_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:textSize="14sp"
                android:typeface="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sk_slider_r_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sk_slider_r_label"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="R"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sk_slider_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/sk_slider_r_value"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sk_slider_g_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sk_slider_g_label"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="G"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sk_slider_g"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/sk_slider_g_value"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sk_slider_b_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sk_slider_b_label"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="B"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sk_slider_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/sk_slider_b_value"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sk_slider_a_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sk_slider_a_label"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="A"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sk_slider_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/sk_slider_a_value"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
