<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_primaryInverse</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Monet</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Monet</item>

        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog.Monet" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Material3</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:background">@drawable/dialog_bg_monet</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.TextView.NoData" parent="AppTheme">
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:padding">@dimen/no_data_padding</item>
        <item name="android:textSize">@dimen/no_data_textSize</item>
    </style>

    <!-- Splash Screen Theme-->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_sk_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- place holder for dark background night theme overrides -->
    <style name="DarkBackground" />

    <!-- shiroikuma-nekokan fork: the 白い熊 猫管 black/yellow base look, applied at
         runtime instead of DynamicColors (see Utils.patchColors). Slot-level user
         overrides are painted on top by SkStyler. -->
    <style name="SkBlackYellow">
        <item name="colorPrimary">#FFFF00</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#FFFF00</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        <item name="colorSecondary">#FFFF00</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#333300</item>
        <item name="colorOnSecondaryContainer">#FFFF00</item>
        <item name="colorTertiary">#FFFF00</item>
        <item name="colorOnTertiary">#000000</item>
        <item name="colorTertiaryContainer">#333300</item>
        <item name="colorOnTertiaryContainer">#FFFF00</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorOnBackground">#FFFF00</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFF00</item>
        <item name="colorSurfaceVariant">#141400</item>
        <item name="colorOnSurfaceVariant">#FFFF00</item>
        <item name="colorSurfaceContainer">#0D0D00</item>
        <item name="colorSurfaceContainerLow">#080800</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerHigh">#141400</item>
        <item name="colorSurfaceContainerHighest">#1A1A00</item>
        <item name="colorSurfaceInverse">#FFFF00</item>
        <item name="colorOnSurfaceInverse">#000000</item>
        <item name="colorOutline">#FFFF00</item>
        <item name="colorOutlineVariant">#666600</item>
        <item name="android:textColorPrimary">#FFFF00</item>
        <item name="android:textColorSecondary">#A6FFFF00</item>
        <item name="android:textColorTertiary">#A6FFFF00</item>
        <item name="android:textColorHint">#80FFFF00</item>
        <item name="colorControlNormal">#FFFF00</item>
        <item name="colorControlActivated">#FFFF00</item>
        <item name="colorAccent">#FFFF00</item>
    </style>
</resources>
