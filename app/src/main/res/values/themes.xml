<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_primaryInverse</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Monet</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Monet</item>

        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog.Monet" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Material3</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:background">@drawable/dialog_bg_monet</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.TextView.NoData" parent="AppTheme">
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:padding">@dimen/no_data_padding</item>
        <item name="android:textSize">@dimen/no_data_textSize</item>
    </style>

    <!-- Splash Screen Theme-->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_sk_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppTheme.Transparent" parent="AppTheme.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- place holder for dark background night theme overrides -->
    <style name="DarkBackground" />

    <!-- shiroikuma-nekokan fork: the 白い熊 猫管 look, applied at runtime instead of
         DynamicColors (see Utils.patchColors).

         It holds no colour. Every colour attribute upstream's layouts and Material's widgets
         read is pointed at a role colour resource (@color/sk_role_…, sk_roles.xml), whose value
         comes from the role table at run time (shiroikuma/SkPalette.kt). Buttons, switches,
         selection marks and menu rows are drawn in code from their roles
         (shiroikuma/SkViewInflater.kt and friends); the styles below give them their shape
         only. -->
    <style name="SkBlackYellow">
        <item name="android:colorBackground">@color/sk_role_background</item>
        <item name="colorOnBackground">@color/sk_role_text</item>
        <item name="colorSurface">@color/sk_role_surface</item>
        <item name="colorOnSurface">@color/sk_role_text</item>
        <item name="colorSurfaceVariant">@color/sk_role_surface</item>
        <item name="colorOnSurfaceVariant">@color/sk_role_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerLow">@color/sk_role_surface</item>
        <item name="colorSurfaceContainer">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerHighest">@color/sk_role_surface</item>
        <item name="colorSurfaceBright">@color/sk_role_surface</item>
        <item name="colorSurfaceDim">@color/sk_role_surface</item>
        <item name="colorSurfaceInverse">@color/sk_role_snackbar_ground</item>
        <item name="colorOnSurfaceInverse">@color/sk_role_snackbar_text</item>
        <item name="colorPrimaryInverse">@color/sk_role_snackbar_action</item>
        <item name="colorPrimary">@color/sk_role_accent</item>
        <item name="colorOnPrimary">@color/sk_role_on_accent</item>
        <item name="colorPrimaryContainer">@color/sk_role_selected</item>
        <item name="colorOnPrimaryContainer">@color/sk_role_on_selected</item>
        <item name="colorSecondary">@color/sk_role_accent</item>
        <item name="colorOnSecondary">@color/sk_role_on_accent</item>
        <item name="colorSecondaryContainer">@color/sk_role_selected</item>
        <item name="colorOnSecondaryContainer">@color/sk_role_on_selected</item>
        <item name="colorTertiary">@color/sk_role_accent</item>
        <item name="colorOnTertiary">@color/sk_role_on_accent</item>
        <item name="colorTertiaryContainer">@color/sk_role_selected</item>
        <item name="colorOnTertiaryContainer">@color/sk_role_on_selected</item>
        <item name="colorError">@color/sk_role_danger</item>
        <item name="colorOnError">@color/sk_role_on_accent</item>
        <item name="colorErrorContainer">@color/sk_role_surface</item>
        <item name="colorOnErrorContainer">@color/sk_role_danger</item>
        <item name="colorOutline">@color/sk_role_outline</item>
        <item name="colorOutlineVariant">@color/sk_role_list_divider</item>
        <item name="android:textColorPrimary">@color/sk_text_primary</item>
        <item name="android:textColorSecondary">@color/sk_text_secondary</item>
        <item name="android:textColorTertiary">@color/sk_role_text_tertiary</item>
        <item name="android:textColorHint">@color/sk_role_text_hint</item>
        <item name="android:textColorHighlight">@color/sk_role_text_selection</item>
        <item name="android:textColorLink">@color/sk_role_link</item>
        <item name="android:editTextColor">@color/sk_role_field_text</item>
        <item name="editTextColor">@color/sk_role_field_text</item>
        <item name="colorControlNormal">@color/sk_role_icon</item>
        <item name="colorControlActivated">@color/sk_role_icon_active</item>
        <item name="colorControlHighlight">@color/sk_role_pressed</item>
        <item name="colorAccent">@color/sk_role_accent</item>
        <item name="android:listDivider">@drawable/sk_list_divider</item>
        <!-- No elevation overlay: in dark themes it tints elevated surfaces (menus, dialogs)
             with the primary colour. -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Popup menus: the menu ground inside the menu frame. Their rows are
             shiroikuma/SkPillMenuItemView. -->
        <item name="popupMenuBackground">@drawable/sk_popup_background</item>
        <item name="popupMenuStyle">@style/Widget.Sk.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Sk.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Sk.ListPopupWindow</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Sk.PopupMenu.Overflow</item>
        <!-- Dialogs: the panel and the text in the dialog roles, the buttons as pills. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Sk.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Sk.MaterialAlertDialog</item>
        <!-- Every button is a pill: the shape here, the colours and the weight of the main
             action in shiroikuma/SkViewInflater. -->
        <item name="materialButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Sk.Pill</item>
        <item name="borderlessButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sk.Pill.Main</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sk.Pill</item>
        <!-- The one place every inflated button, switch, check box, radio button and floating
             button passes through. -->
        <item name="viewInflaterClass">protect.card_locker.shiroikuma.SkViewInflater</item>
    </style>

    <!-- Every dialog, Material's and AppCompat's (the preference dialogs). The panel's frame is
         drawn in code (shiroikuma/SkDialogs.kt): Material builds the panel itself and offers no
         attribute for a frame. -->
    <style name="ThemeOverlay.Sk.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="skDialog">true</item>
        <item name="android:windowBackground">@drawable/sk_dialog_background</item>
        <item name="colorSurface">@color/sk_role_dialog_ground</item>
        <item name="colorSurfaceContainerHigh">@color/sk_role_dialog_ground</item>
        <item name="colorOnSurface">@color/sk_role_dialog_title</item>
        <item name="colorOnSurfaceVariant">@color/sk_role_dialog_text</item>
        <item name="android:textColorPrimary">@color/sk_role_dialog_text</item>
        <item name="android:textColorSecondary">@color/sk_role_dialog_text</item>
        <item name="android:textColorAlertDialogListItem">@color/sk_role_dialog_text</item>
        <item name="textColorAlertDialogListItem">@color/sk_role_dialog_text</item>
        <item name="android:buttonTint">@color/sk_mark</item>
        <item name="android:checkMarkTint">@color/sk_mark</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sk.Pill.Main</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Sk</item>
    </style>

    <!-- The rows of a dialog's action list are pills with an icon (shiroikuma/SkDialogItemView,
         swapped in through sk_dialog_item.xml); the choice lists keep Material's rows. -->
    <style name="MaterialAlertDialog.Sk" parent="MaterialAlertDialog.Material3">
        <item name="listItemLayout">@layout/sk_dialog_item</item>
    </style>

    <!-- The pill: fully round, a frame, the ground showing through. Shape only — frame, label
         and ground are roles, applied by shiroikuma/SkViewInflater (see shiroikuma/SkPill.kt
         for views built in code). -->
    <style name="Widget.Sk.Pill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="strokeWidth">1.25dp</item>
        <item name="cornerRadius">100dp</item>
    </style>

    <style name="Widget.Sk.Pill.Main">
        <item name="android:textStyle">bold</item>
        <item name="strokeWidth">3dp</item>
    </style>

    <style name="Widget.Sk.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/sk_popup_background</item>
    </style>

    <style name="Widget.Sk.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/sk_popup_background</item>
    </style>

    <style name="Widget.Sk.ListPopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/sk_popup_background</item>
    </style>
</resources>
